{
  "name": "kosodate-hitoiki-backend",
  "private": true,
  "scripts": {
    "lint:md": "markdownlint-cli2",
    "lint:config": "prettier --check \".github/workflows/*.{yml,yaml}\" \"*.json\"",
    "check": "npm run lint:md && npm run lint:config",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "functions:check": "cd supabase/functions && deno fmt --check && deno lint && deno check \"**/*.ts\"",
    "functions:test": "cd supabase/functions && deno test --frozen",
    "functions:eval": "cd supabase/functions && deno run --allow-env=OPENAI_API_KEY --allow-net=api.openai.com _shared/moderation/eval.ts",
    "test:concurrency": "bash supabase/tests/concurrency/run.sh",
    "test:functions-integration": "bash supabase/tests/functions/run.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "deno": "2.9.6",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9",
    "supabase": "2.118.0"
  }
}
